# App settings
PROJECT_NAME="AI-Based Intelligent Examination Platform"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-in-production-min-32-chars-long"
SERVER_SECRET="server-paper-generation-secret-key-change-in-prod"

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
EXAM_ACCESS_TOKEN_EXPIRE_MINUTES=15
SESSION_TOKEN_EXPIRE_MINUTES=10

# Scheduler & Timed Engine
RUN_SCHEDULER=true
SERVER_DEADLINE_GRACE_SECONDS=3

# LLM & AI Configuration
OPENAI_API_KEY="sk-proj-your-api-key-here"
LLM_MODEL="gpt-4o"
OCR_PROVIDER="tesseract"

# Redis & Storage
REDIS_URL="redis://localhost:6379/0"
STORAGE_DIR="uploads"

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=exam_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exam_db
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exam_db_test
