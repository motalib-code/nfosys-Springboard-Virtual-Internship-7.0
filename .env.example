# App settings
PROJECT_NAME="AI-Based Intelligent Examination Platform"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-in-production-min-32-chars-long"
SERVER_SECRET="server-paper-generation-secret-key-change-in-prod"

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
EXAM_ACCESS_TOKEN_EXPIRE_MINUTES=15
SESSION_TOKEN_EXPIRE_MINUTES=10

# Engine & DB Pool Configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=exam_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exam_db
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exam_db_test

# Scheduler & Worker Settings
RUN_SCHEDULER=true
SERVER_DEADLINE_GRACE_SECONDS=3

# Storage & Upload Settings
MAX_UPLOAD_SIZE_BYTES=8388608
UPLOAD_DIR=uploads

# Redis & Rate Limiting (Optional)
REDIS_URL=redis://localhost:6379/0

# LLM & OCR Configuration
OPENAI_API_KEY=mock-key
OPENAI_MODEL_NAME=gpt-4o
LLM_TIMEOUT_SECONDS=30
OCR_PROVIDER=tesseract

# Word Count Constraints
SHORT_ANSWER_MIN_WORDS=1
SHORT_ANSWER_MAX_WORDS=150
LONG_ANSWER_MIN_WORDS=1
LONG_ANSWER_MAX_WORDS=1000
